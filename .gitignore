# Binaries (rooted so cmd/fleet/ stays tracked)
/fleet
/dist/
*.exe
*.test
*.out

# Go workspace
go.work
go.work.sum

# Sandbox-redirected Go caches (never commit build artifacts)
/.gocache/
/.gomodcache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local fleet state (never commit user state)
.fleet/

# Python bytecode caches (skill tests run via pytest land __pycache__/)
__pycache__/
*.pyc

# Secrets — block all .env files but keep .env.example / .env.sample committable
.env
.env.*
!.env.example
!.env.sample
